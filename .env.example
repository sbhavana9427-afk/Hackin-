# Neo4j (optional: app falls back to labelled demo data if unset/unreachable)
NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Sarvam AI (server-side only, never exposed to the browser)
SARVAM_API_KEY=
# Admin access (HTTP Basic auth: any username, this password)
ADMIN_PASSWORD=change-me
